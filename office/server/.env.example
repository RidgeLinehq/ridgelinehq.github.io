# Copy to .env and export before starting (or set them on the host). Never commit .env.
RIDGELINE_DB=./ridgeline.db
RIDGELINE_TOKEN=change-me-to-a-long-random-string     # required before exposing beyond localhost
RIDGELINE_TZ=America/Chicago
RIDGELINE_WORKER=true
RIDGELINE_SCHEDULER=true
# AI (Quinn/Parker/Echo/Nova). Without it those tasks fail with "not configured".
ANTHROPIC_API_KEY=
RIDGELINE_MODEL=claude-sonnet-5-5
RIDGELINE_COST_PER_MTOK_IN=
RIDGELINE_COST_PER_MTOK_OUT=
# Research (Scout). Without it Scout fails with "not configured"; add leads by hand instead.
BRAVE_API_KEY=
# Email (Echo). Without all three, drafts are never sent (draft-only). Gmail: App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
